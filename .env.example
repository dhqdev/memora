# App (Expo) — URL do servidor de IA do Memora.
# No celular com Expo Go, use o IP da sua máquina na rede (ex.: http://192.168.0.10:8787)
# Sem essa variável o app funciona com respostas offline da Lumi.
EXPO_PUBLIC_AI_URL=http://192.168.0.10:8787

# Servidor (server/index.mjs) — NUNCA coloque a chave no app.
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-haiku-5-5
PORT=8787
