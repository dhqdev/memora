{
  "expo": {
    "name": "Memora",
    "slug": "memora",
    "scheme": "memora",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dhqdev.memora",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "O Memora usa suas fotos para guardar seus moments.",
        "NSCameraUsageDescription": "O Memora usa a câmera para registrar seus moments.",
        "NSLocationWhenInUseUsageDescription": "O Memora usa sua localização para lembrar onde cada moment aconteceu.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dhqdev.memora",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121211"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Memora usa suas fotos para guardar seus moments."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Memora usa sua localização para lembrar onde cada moment aconteceu."
        }
      ],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F2EFE6",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#121211"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
