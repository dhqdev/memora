    "@infinitered/react-native-mlkit-face-detection": "^5.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "^2.14.0",
    "expo": "~58.0.25",
    "expo-audio": "~58.0.12",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.16",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
